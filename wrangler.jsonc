{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haackr-website-astro",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"route": {
		"pattern": "haackr.com/*",
		"zone_name": "haackr.com"
	}
}