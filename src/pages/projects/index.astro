---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Icon from "../../components/Icon.astro";
import FeaturedProjects from "../../components/FeaturedProjects.astro";

const allProjects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return a.data.order - b.data.order;
  }
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const featuredProjects = allProjects.filter((p) => p.data.featured);
const otherProjects = allProjects.filter((p) => !p.data.featured);

const PAGE_TITLE = "Projects | Ryan Haack";
const PAGE_DESCRIPTION =
  "A showcase of software engineering, PMIS workflow automation, and web development projects by Ryan Haack.";
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  image={featuredProjects[0]?.data.heroImage}
  mainClass="max-w-[960px] m-auto py-12 px-4"
>
  <header class="mb-12 text-center sm:text-left">
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
      Projects
    </h1>
    <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl">
      A selection of personal projects, PMIS automation solutions, and software applications I've built.
    </p>
  </header>

  <!-- Featured Projects Section -->
  <div class="mb-16">
    <FeaturedProjects />
  </div>

  <!-- All / Other Projects Grid -->
  <section>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">
      {featuredProjects.length > 0 ? "More Projects" : "All Projects"}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {(otherProjects.length > 0 ? otherProjects : allProjects).map((project) => (
        <article class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 flex flex-col justify-between hover:border-cyan-400 dark:hover:border-cyan-500 hover:shadow-md dark:hover:shadow-slate-950/50 transition-all group">
          <div>
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 mb-2">
              <span class="inline-flex items-center gap-1">
                <Icon name="calendar" class="w-3.5 h-3.5 text-cyan-700 dark:text-cyan-400" />
                <FormattedDate date={project.data.pubDate} />
              </span>
              <div class="flex items-center gap-2">
                {project.data.repoUrl && (
                  <a
                    href={project.data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 dark:text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors"
                    title="Source Code"
                  >
                    <Icon name="github" class="w-3.5 h-3.5" />
                  </a>
                )}
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-cyan-600 dark:text-cyan-400 hover:text-cyan-800 dark:hover:text-cyan-300 transition-colors"
                    title="Live Demo"
                  >
                    <Icon name="external" class="w-3.5 h-3.5" />
                  </a>
                )}
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-cyan-700 dark:group-hover:text-cyan-400 transition-colors mb-2">
              <a href={`/projects/${project.id}/`}>
                {project.data.title}
              </a>
            </h3>

            <p class="text-sm text-slate-600 dark:text-slate-300 mb-4 leading-relaxed">
              {project.data.description}
            </p>

            {project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs font-medium rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
            <a
              href={`/projects/${project.id}/`}
              class="text-xs font-semibold text-cyan-700 dark:text-cyan-400 hover:text-cyan-900 dark:hover:text-cyan-300 inline-flex items-center gap-1"
            >
              <span>Read case study</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

