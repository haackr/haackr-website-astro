---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { ClientRouter } from "astro:transitions";
import me from "../content/images/me.jpg";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <style is:global>
      p {
        font-family: "Poppins", sans-serif;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Work Sans Variable", sans-serif;
      }
    </style>
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main class="w-full">
      <header>
        <div class="h-[75vh] flex max-w-[900px] m-auto p-3">
          <div>
            <h1 class="mt-[25vh] text-3xl sm:text-4xl">
              Hi, I'm <span class="text-cyan-600 underline underline-offset-6"
                >Ryan.</span
              >
              <br />
              I'm a <span class="text-cyan-800"><span id="typed-output"></span></span>
            </h1>
          </div>
        </div>
        <article>
          <div class="max-w-[900px] p-3 m-auto pb-10">
            <h2 class="text-3xl text-center mb-5">About Me</h2>
            <div class="flex flex-col items-center lg:flex-row-reverse">
              <Image
                src={me}
                width={200}
                class="rounded-full lg:ml-5 mb-5 lg:mb-0"
                alt="Ryan Haack"
              />
              <p class="text-xl text-slate-800">
                I'm a software developer and PMIS consultant from Albuquerque, New Mexico. I'm currently working as a Senior Consultant at <a href="https://avicado.com">Avicado</a> and pursuing my masters in computer science at CU Bouder. In my free time, I enjoy spending time outdoors running, hiking, and camping.
              </p>
            </div>
          </div>
          <div class="py-20">
            <h2 class="text-3xl text-center mb-5">Contact Me</h2>
            <ContactForm />
          </div>
        </article>
        <Footer />
      </header>
    </main>

    <script>
      import Typed from "typed.js";

      function initTyped() {
        const el = document.getElementById("typed-output");
        if (!el) return;
        return new Typed(el, {
          strings: [
            "PMIS Consultant.",
            "runner.",
            "software developer.",
            "grad student",
            "data wizard",
          ],
          typeSpeed: 50,
          backSpeed: 30,
          cursorChar: "|",
          loop: true,
        });
      }

      let typedInstance: Typed | undefined;
      document.addEventListener("astro:page-load", () => {
        typedInstance?.destroy();
        typedInstance = initTyped();
      });
    </script>
  </body>
</html>
