---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from "../components/ContactForm.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import  me from "../content/images/me.jpg"
import '../styles/global.css'
---	

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
			<header>
				<div class="h-[75vh] flex max-w-[900px] m-auto p-2">
					<div>
						<h1 class="mt-[25vh] text-4xl">
							Hi, I'm <span class="text-cyan-600 underline underline-offset-6">Ryan Haack</span>. <br />
							I'm a full stack developer &  PMIS consultant.
						</h1>
					</div>
				</div>
			</header>
			<article>
				<div class="max-w-[900px] p-2 m-auto pb-10">
					<h2 class="text-3xl text-center mb-5">About Me</h2>
					<div class="flex flex-col items-center lg:flex-row-reverse">
						<Image
							src={me}
							width={200}
							class="rounded-full lg:ml-5 mb-5 lg:mb-0"
							alt="Ryan Haack"
						/>
						<p class="text-xl text-slate-800">
							I'm a full stack developer and PMIS consultant from Albuquerque, New Mexico. I've
							been programming since I was a kid messing around with BASIC.
							I'm currently employed at Avicado Construction Technology Services as a Senior Consultant. 
							In my free time I enjoy hiking, climbing, backpacking, playing guitar, and cooking.
						</p>
					</div>
				</div>
			</article>
			<div class="py-20">
				<h2 class="text-3xl text-center mb-5">Contact Me</h2>
				<ContactForm />
			</div>
		</main>
		<Footer />
	</body>
</html>
