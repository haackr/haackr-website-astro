---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import LatestPost from "../components/LatestPost.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import me from "../content/images/me.jpg";

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://haackr.com/#website",
      url: "https://haackr.com",
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
    },
    {
      "@type": "Person",
      "@id": "https://haackr.com/#person",
      name: "Ryan Haack",
      url: "https://haackr.com",
      jobTitle: "Lead Senior Consultant & Software Developer",
      worksFor: {
        "@type": "Organization",
        name: "Avicado",
        url: "https://avicado.com",
      },
      sameAs: [
        "https://github.com/haackr",
        "https://www.linkedin.com/in/haackr/",
        "https://www.strava.com/athletes/ryan_haack",
        "https://www.instagram.com/haackr_505/",
        "https://www.youtube.com/@haackr",
      ],
    },
  ],
};
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image={me}
  schema={homeSchema}
>
  <section class="h-[50vh] flex max-w-[960px] m-auto p-4">
    <div>
      <h1 class="mt-[25vh] text-2xl sm:text-4xl">
        Hi, I'm <span class="text-cyan-600 underline underline-offset-6">Ryan.</span>
        <br />
        I'm a <span class="text-cyan-800"><span id="typed-output">software developer.</span></span>
      </h1>
    </div>
  </section>

  <section class="max-w-[960px] p-4 m-auto pb-10">
    <h2 class="text-2xl sm:text-3xl text-center mb-5 font-extrabold">About Me</h2>
    <div class="flex flex-col items-center lg:flex-row-reverse">
      <Image
        src={me}
        width={200}
        height={200}
        quality={85}
        format="webp"
        loading="eager"
        decoding="async"
        class="rounded-full lg:ml-10 mb-5 lg:mb-0"
        alt="Ryan Haack"
      />
      <div>
        <p class="text-lg sm:text-xl text-slate-800 mb-3">
          I'm a software developer and PMIS consultant from Albuquerque, New Mexico. I'm currently working as a Lead Senior Consultant at <a href="https://avicado.com" class="text-cyan-700 hover:text-cyan-900 underline">Avicado</a> and pursuing my master's in computer science at CU Boulder.
        </p>
        <p class="text-lg sm:text-xl text-slate-800 mb-3">
          Day-to-day, my work centers around modernizing project management systems, developing custom software tools, and improving data visibility for teams. In my free time, I enjoy spending time outdoors running, hiking, and camping.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-[960px] p-4 m-auto py-20">
    <LatestPost />
    <div class="mt-6 text-center">
      <a
        href="/blog/"
        class="text-sm font-semibold text-cyan-700 hover:text-cyan-800 inline-flex items-center gap-1 group/link"
      >
        <span>View all articles</span>
        <span class="group-hover/link:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>
  </section>

  <section class="max-w-[960px] p-4 m-auto py-20">
    <FeaturedProjects />
    <div class="mt-6 text-center">
      <a
        href="/projects/"
        class="text-sm font-semibold text-cyan-700 hover:text-cyan-800 inline-flex items-center gap-1 group/link"
      >
        <span>View all projects</span>
        <span class="group-hover/link:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>
  </section>

  <section class="py-20">
    <h2 class="text-2xl sm:text-3xl text-center mb-5 font-extrabold">Contact Me</h2>
    <ContactForm />
  </section>

  <script>
    import Typed from "typed.js";

    function initTyped() {
      const el = document.getElementById("typed-output");
      if (!el) return;
      return new Typed(el, {
        strings: [
          "PMIS Consultant.",
          "runner.",
          "software developer.",
          "grad student.",
          "photographer.",
        ],
        typeSpeed: 50,
        backSpeed: 30,
        cursorChar: "|",
        loop: true,
      });
    }

    let typedInstance: Typed | undefined;
    document.addEventListener("astro:page-load", () => {
      typedInstance?.destroy();
      typedInstance = initTyped();
    });
  </script>
</BaseLayout>

