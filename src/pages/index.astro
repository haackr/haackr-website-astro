---
import { Image } from "astro:assets";
import { ReactTyped } from "react-typed";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { ViewTransitions } from "astro:transitions";
import me from "../content/images/me_new.jpg";
import "../styles/global.css";
import "@fontsource/poppins";
import "@fontsource-variable/work-sans";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ViewTransitions />
    <style is:global>
      p {
        font-family: "Poppins", sans-serif;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Work Sans Variable", sans-serif;
      }
    </style>
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main class="w-full">
      <header>
        <div class="h-[75vh] flex max-w-[900px] m-auto p-3">
          <div>
            <h1 class="mt-[25vh] text-3xl sm:text-4xl">
              Hi, I'm <span class="text-cyan-600 underline underline-offset-6"
                >Ryan.</span
              >
              <br />
              I'm a <span class="text-cyan-800">
                <ReactTyped
                  strings={[
                    "PMIS Consultant.",
                    "runner.",
                    "guitarist.",
                    "photographer.",
                    "hiker.",
                    "developer.",
                    "mountain biker.",
                  ]}
                  typeSpeed={50}
                  backSpeed={30}
                  loop
                  client:load
                />
              </span>
            </h1>
          </div>
        </div>
        <article>
          <div class="max-w-[900px] p-3 m-auto pb-10">
            <h2 class="text-3xl text-center mb-5">About Me</h2>
            <div class="flex flex-col items-center lg:flex-row-reverse">
              <Image
                src={me}
                width={200}
                class="rounded-full lg:ml-5 mb-5 lg:mb-0"
                alt="Ryan Haack"
              />
              <p class="text-xl text-slate-800">
                I'm a PMIS consultant from Albuquerque, New Mexico. I'm
                currently working as a Senior Consultant. In my free time, I
                enjoy hiking, camping, running, mountain biking, and playing
                guitar.
              </p>
            </div>
          </div>
          <div class="py-20">
            <h2 class="text-3xl text-center mb-5">Contact Me</h2>
            <ContactForm />
          </div>
        </article>
        <Footer />
      </header>
    </main>
  </body>
</html>
