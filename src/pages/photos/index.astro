---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Icon from "../../components/Icon.astro";

const allGalleries = (
  await getCollection("galleries", ({ data }) => !data.draft)
).sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return a.data.order - b.data.order;
  }
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const featuredGallery = allGalleries.find((g) => g.data.featured) || allGalleries[0];
const otherGalleries = allGalleries.filter((g) => g.id !== featuredGallery?.id);

const PAGE_TITLE = "Photography | Ryan Haack";
const PAGE_DESCRIPTION =
  "Landscape and outdoor photography";
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  image={featuredGallery?.data.coverImage}
  mainClass="max-w-[960px] m-auto py-12 px-4"
>
  <header class="mb-12 text-center sm:text-left">
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
      Photography
    </h1>
    <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl">
      High desert and mountain landscape photography. 
    </p>
  </header>

  <!-- Featured Album Spotlight -->
  {
    featuredGallery && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
          <span>Featured Collection</span>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-cyan-100 dark:bg-cyan-950 text-cyan-800 dark:text-cyan-300 border dark:border-cyan-800">
            Spotlight
          </span>
        </h2>

        <article class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-lg dark:hover:shadow-slate-950/50 transition-all duration-300 group grid grid-cols-1 md:grid-cols-12 gap-0">
          <a
            href={`/photos/${featuredGallery.id}/`}
            class="block overflow-hidden md:col-span-7 aspect-video md:aspect-auto bg-slate-100 dark:bg-slate-800 relative"
          >
            <Image
              src={featuredGallery.data.coverImage}
              alt={featuredGallery.data.coverImageAlt || featuredGallery.data.title}
              width={900}
              height={500}
              quality={85}
              format="webp"
              widths={[400, 750, 1200]}
              sizes="(max-width: 768px) 100vw, 55vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute bottom-3 right-3 bg-black/70 backdrop-blur-sm text-white px-3 py-1 rounded-full text-xs font-medium flex items-center gap-1.5">
              <Icon name="image" class="w-3.5 h-3.5 text-cyan-400" />
              <span>{featuredGallery.data.photos.length} Photos</span>
            </div>
          </a>

          <div class="p-6 sm:p-8 flex flex-col justify-between md:col-span-5">
            <div>
              <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                {featuredGallery.data.location && (
                  <span class="inline-flex items-center gap-1 text-cyan-800 dark:text-cyan-300 font-medium">
                    <Icon name="location" class="w-3.5 h-3.5 text-cyan-700 dark:text-cyan-400" />
                    {featuredGallery.data.location}
                  </span>
                )}
                <span class="inline-flex items-center gap-1">
                  <Icon name="calendar" class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" />
                  <FormattedDate date={featuredGallery.data.pubDate} />
                </span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 dark:text-white group-hover:text-cyan-700 dark:group-hover:text-cyan-400 transition-colors mb-3 leading-snug">
                <a href={`/photos/${featuredGallery.id}/`}>
                  {featuredGallery.data.title}
                </a>
              </h3>

              <p class="text-slate-600 dark:text-slate-300 line-clamp-4 mb-6 leading-relaxed text-sm">
                {featuredGallery.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <a
                href={`/photos/${featuredGallery.id}/`}
                class="text-sm font-semibold text-cyan-700 dark:text-cyan-400 hover:text-cyan-800 dark:hover:text-cyan-300 inline-flex items-center gap-1 group/link"
              >
                <span>View Gallery</span>
                <span class="group-hover/link:translate-x-0.5 transition-transform">→</span>
              </a>
            </div>
          </div>
        </article>
      </section>
    )
  }

  <!-- All / Other Photo Albums Grid -->
  <section>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">
      All Albums & Series
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {(otherGalleries.length > 0 ? otherGalleries : allGalleries).map((gallery) => (
        <article class="flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-lg dark:hover:shadow-slate-950/50 transition-all duration-300 group">
          <a
            href={`/photos/${gallery.id}/`}
            class="block overflow-hidden aspect-video bg-slate-100 dark:bg-slate-800 relative"
          >
            <Image
              src={gallery.data.coverImage}
              alt={gallery.data.coverImageAlt || gallery.data.title}
              width={720}
              height={400}
              quality={85}
              format="webp"
              widths={[360, 720, 1080]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute bottom-3 right-3 bg-black/70 backdrop-blur-sm text-white px-2.5 py-0.5 rounded-full text-xs font-medium flex items-center gap-1">
              <Icon name="image" class="w-3 h-3 text-cyan-400" />
              <span>{gallery.data.photos.length} Photos</span>
            </div>
          </a>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400 mb-2">
                {gallery.data.location && (
                  <span class="inline-flex items-center gap-1 text-cyan-800 dark:text-cyan-300 font-medium">
                    <Icon name="location" class="w-3.5 h-3.5 text-cyan-700 dark:text-cyan-400" />
                    {gallery.data.location}
                  </span>
                )}
                <span class="inline-flex items-center gap-1">
                  <Icon name="calendar" class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" />
                  <FormattedDate date={gallery.data.pubDate} />
                </span>
              </div>

              <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-cyan-700 dark:group-hover:text-cyan-400 transition-colors mb-2 leading-snug">
                <a href={`/photos/${gallery.id}/`}>
                  {gallery.data.title}
                </a>
              </h3>

              <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-3 mb-4 leading-relaxed">
                {gallery.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <a
                href={`/photos/${gallery.id}/`}
                class="text-sm font-semibold text-cyan-700 dark:text-cyan-400 hover:text-cyan-800 dark:hover:text-cyan-300 inline-flex items-center gap-1 group/link"
              >
                <span>View Gallery</span>
                <span class="group-hover/link:translate-x-0.5 transition-transform">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

