---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Icon from "../../components/Icon.astro";
import PhotoLightbox from "../../components/PhotoLightbox.astro";
import { ClientRouter } from "astro:transitions";
import "../../styles/global.css";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries", ({ data }) => !data.draft);
  return galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: gallery,
  }));
}

type Props = CollectionEntry<"galleries">;

const gallery = Astro.props;
const { Content } = await render(gallery);
const { title, description, pubDate, location, photos = [], coverImage } = gallery.data;

const PAGE_TITLE = `${title} | Photography | Ryan Haack`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={PAGE_TITLE} description={description} image={coverImage?.src} />
    <ClientRouter />
    <style is:global>
      p {
        font-family: "Poppins", sans-serif;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Work Sans Variable", sans-serif;
      }
      .gallery-prose {
        color: #475569;
        font-size: 1.05rem;
        line-height: 1.75;
      }
      .gallery-prose p {
        margin-bottom: 1.5rem;
      }

      :root {
        --gallery-row-height: 180px;
      }
      @media (min-width: 640px) {
        :root {
          --gallery-row-height: 230px;
        }
      }
      @media (min-width: 1024px) {
        :root {
          --gallery-row-height: 270px;
        }
      }

      .photo-card {
        min-width: 0;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="max-w-[1120px] m-auto py-10 px-4">
      <!-- Back Navigation -->
      <nav class="mb-8">
        <a
          href="/photos"
          class="inline-flex items-center gap-2 text-cyan-700 hover:text-cyan-900 font-medium transition-colors"
        >
          <Icon name="arrow-left" class="w-4 h-4" />
          <span>Back to Photos</span>
        </a>
      </nav>

      <!-- Album Header -->
      <header class="mb-10 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 mb-3">
          {
            location && (
              <span class="inline-flex items-center gap-1 text-cyan-800 font-medium bg-cyan-50 border border-cyan-200 px-2.5 py-0.5 rounded-full text-xs">
                <Icon name="location" class="w-3.5 h-3.5 text-cyan-700" />
                {location}
              </span>
            )
          }
          <span class="inline-flex items-center gap-1 text-xs">
            <Icon name="calendar" class="w-3.5 h-3.5 text-slate-400" />
            <FormattedDate date={pubDate} />
          </span>
          <span class="text-xs text-slate-400">·</span>
          <span class="text-xs text-slate-500">{photos.length} Photographs</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          {title}
        </h1>

        <p class="text-lg text-slate-700 leading-relaxed mb-6">
          {description}
        </p>

        <!-- Markdown Story/Intro if present -->
        <div class="gallery-prose border-t border-slate-200 pt-6">
          <Content />
        </div>
      </header>

      <!-- Photo Gallery Justified Row Layout -->
      <section class="mt-8">
        <div class="photo-gallery flex flex-wrap gap-2 sm:gap-3">
          {
            photos.map((photo, index) => {
              const ar =
                photo.src.width && photo.src.height
                  ? photo.src.width / photo.src.height
                  : 1.5;
              const roundedAr = Number(ar.toFixed(4));
              return (
                <button
                  type="button"
                  class="photo-card group relative block overflow-hidden rounded-xl bg-slate-100 border border-slate-200/80 shadow-xs hover:shadow-xl transition-all duration-300 cursor-pointer text-left focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2"
                  style={{
                    flexGrow: roundedAr,
                    flexBasis: `calc(var(--gallery-row-height, 280px) * ${roundedAr})`,
                    aspectRatio: `${photo.src.width} / ${photo.src.height}`,
                    maxWidth: "100%",
                  }}
                  data-photo-item
                  data-photo-src={photo.src.src}
                  data-photo-alt={
                    photo.alt || photo.caption || `${title} photo ${index + 1}`
                  }
                  data-photo-caption={photo.caption || ""}
                  data-photo-location={photo.location || location || ""}
                  data-photo-camera={photo.camera || ""}
                  aria-label={`Open photo: ${photo.caption || title}`}
                >
                  <Image
                    src={photo.src}
                    alt={photo.alt || photo.caption || title}
                    width={Math.min(photo.src.width, 1400)}
                    loading={index < 4 ? "eager" : "lazy"}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 block"
                  />

                  <!-- Hover Overlay with Caption -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3 sm:p-4">
                    {photo.caption && (
                      <p class="text-white text-sm font-medium line-clamp-2 mb-1">
                        {photo.caption}
                      </p>
                    )}
                    <div class="flex items-center justify-between text-xs text-slate-300">
                      <span>{photo.location || location || ""}</span>
                      <span class="text-cyan-300 font-medium">Click to enlarge</span>
                    </div>
                  </div>
                </button>
              );
            })
          }
          <!-- Spacer element to absorb extra width on the last row and prevent over-stretching -->
          <div
            class="gallery-last-spacer pointer-events-none"
            aria-hidden="true"
            style={{
              flexGrow: 99999,
              flexBasis: "calc(var(--gallery-row-height, 280px) * 1.5)",
              height: 0,
              minHeight: 0,
              margin: 0,
              padding: 0,
            }}
          >
          </div>
        </div>
      </section>

      <!-- Lightbox Modal -->
      <PhotoLightbox />
    </main>
    <Footer />
  </body>
</html>
