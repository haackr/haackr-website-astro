---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Icon from "../../components/Icon.astro";
import PhotoLightbox from "../../components/PhotoLightbox.astro";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries", ({ data }) => !data.draft);
  return galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: gallery,
  }));
}

type Props = CollectionEntry<"galleries">;

const gallery = Astro.props;
const { Content } = await render(gallery);
const { title, description, pubDate, location, photos = [], coverImage } = gallery.data;

const coverImageSrc =
  typeof coverImage === "object" && coverImage !== null
    ? coverImage.src
    : coverImage;

const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: description,
  datePublished: pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: "Ryan Haack",
    url: "https://haackr.com",
  },
  ...(location ? { contentLocation: location } : {}),
  ...(coverImageSrc
    ? { image: new URL(coverImageSrc, Astro.site).href }
    : {}),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": Astro.url.href,
  },
};

const PAGE_TITLE = `${title} | Photography | Ryan Haack`;
---

<BaseLayout
  title={PAGE_TITLE}
  description={description}
  image={coverImage}
  type="article"
  publishedTime={pubDate}
  schema={gallerySchema}
  mainClass="max-w-[1120px] m-auto py-10 px-4"
>
  <style>
    .gallery-prose {
      color: #475569;
      font-size: 1.05rem;
      line-height: 1.75;
    }
    :global(.dark) .gallery-prose {
      color: #cbd5e1;
    }
    .gallery-prose p {
      margin-bottom: 1.5rem;
    }

    /* Mobile: single-column full-width vertical stack */
    .photo-gallery {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .photo-card {
      width: 100%;
      min-width: 0;
    }

    .gallery-last-spacer {
      display: none;
    }

    /* Tablet & Desktop: justified flex row layout */
    @media (min-width: 640px) {
      :root {
        --gallery-row-height: 230px;
      }

      .photo-gallery {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .photo-card {
        width: auto;
        flex-grow: var(--ar, 1.5);
        flex-basis: calc(var(--gallery-row-height, 230px) * var(--ar, 1.5));
      }

      .gallery-last-spacer {
        display: block;
        flex-grow: 99999;
        flex-basis: calc(var(--gallery-row-height, 230px) * 1.5);
        height: 0;
        min-height: 0;
        margin: 0;
        padding: 0;
      }
    }

    @media (min-width: 1024px) {
      :root {
        --gallery-row-height: 270px;
      }
    }
  </style>

  <!-- Back Navigation -->
  <nav class="mb-8">
    <a
      href="/photos/"
      class="inline-flex items-center gap-2 text-cyan-700 dark:text-cyan-400 hover:text-cyan-900 dark:hover:text-cyan-300 font-medium transition-colors"
    >
      <Icon name="arrow-left" class="w-4 h-4" />
      <span>Back to Photos</span>
    </a>
  </nav>

  <!-- Album Header -->
  <header class="mb-10 max-w-3xl">
    <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400 mb-3">
      {
        location && (
          <span class="inline-flex items-center gap-1 text-cyan-800 dark:text-cyan-300 font-medium bg-cyan-50 dark:bg-cyan-950 border border-cyan-200 dark:border-cyan-800 px-2.5 py-0.5 rounded-full text-xs">
            <Icon name="location" class="w-3.5 h-3.5 text-cyan-700 dark:text-cyan-400" />
            {location}
          </span>
        )
      }
      <span class="inline-flex items-center gap-1 text-xs">
        <Icon name="calendar" class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" />
        <FormattedDate date={pubDate} />
      </span>
      <span class="text-xs text-slate-400">·</span>
      <span class="text-xs text-slate-500 dark:text-slate-400">{photos.length} Photographs</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      {title}
    </h1>

    <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-6">
      {description}
    </p>

    <!-- Markdown Story/Intro if present -->
    <div class="gallery-prose border-t border-slate-200 dark:border-slate-800 pt-6">
      <Content />
    </div>
  </header>

  <!-- Photo Gallery Layout -->
  <section class="mt-8">
    <div class="photo-gallery">
      {
        photos.map((photo, index) => {
          const ar =
            photo.src.width && photo.src.height
              ? photo.src.width / photo.src.height
              : 1.5;
          const roundedAr = Number(ar.toFixed(4));
          return (
            <button
              type="button"
              class="photo-card group relative block overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-xs hover:shadow-xl transition-all duration-300 cursor-pointer text-left focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
              style={{
                "--ar": roundedAr,
                aspectRatio: `${photo.src.width} / ${photo.src.height}`,
                maxWidth: "100%",
              }}
              data-photo-item
              data-photo-index={index}
              aria-label={`Open photo: ${photo.caption || title}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt || photo.caption || title}
                width={600}
                quality={85}
                format="webp"
                widths={[360, 600, 900]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                loading={index < 4 ? "eager" : "lazy"}
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 block"
              />

              <!-- Hover Overlay with Caption -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3 sm:p-4">
                {photo.caption && (
                  <p class="text-white text-sm font-medium line-clamp-2 mb-1">
                    {photo.caption}
                  </p>
                )}
                <div class="flex items-center justify-between text-xs text-slate-300">
                  <span>{photo.location || location || ""}</span>
                  <span class="text-cyan-300 font-medium">Click to enlarge</span>
                </div>
              </div>
            </button>
          );
        })
      }
      <!-- Spacer element (only active on desktop rows) -->
      <div class="gallery-last-spacer pointer-events-none" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <PhotoLightbox photos={photos} title={title} defaultLocation={location} />
</BaseLayout>
