---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import LatestPost from "../../components/LatestPost.astro";

const posts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPost = posts[0];
const otherPosts = posts.slice(1);

const PAGE_TITLE = "Blog | Ryan Haack";
const PAGE_DESCRIPTION =
  "Articles, technical guides, and thoughts on software engineering, PMIS systems, and web development.";
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  image={latestPost?.data.heroImage}
  mainClass="max-w-[960px] m-auto py-12 px-4"
>
  <header class="mb-12 text-center sm:text-left">
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">
      Blog
    </h1>
    <p class="text-base sm:text-xl text-slate-600 max-w-2xl">
      Articles, technical guides, and thoughts on software engineering, PMIS systems, and development.
    </p>
  </header>

  <!-- Latest Featured Article -->
  <LatestPost />

  <!-- Other Articles Grid -->
  {
    otherPosts.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6">
          All Articles
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {otherPosts.map((post) => (
            <BlogPostCard post={post} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

