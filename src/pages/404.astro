---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const PAGE_TITLE = "404: Page Not Found | Ryan Haack";
const PAGE_DESCRIPTION = "Sorry, the page you are looking for does not exist or has been moved.";

const notFoundSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: PAGE_TITLE,
  description: PAGE_DESCRIPTION,
  url: "https://haackr.com/404",
};

const quickLinks = [
  {
    title: "Blog",
    description: "Technical articles, guides, and thoughts on software engineering.",
    href: "/blog/",
    icon: "calendar" as const,
  },
  {
    title: "Projects",
    description: "Explore software applications, hardware builds, and AI experiments.",
    href: "/projects/",
    icon: "astro" as const,
  },
  {
    title: "Photography",
    description: "Landscape and outdoor mountain photography albums.",
    href: "/photos/",
    icon: "camera" as const,
  },
  {
    title: "Get in Touch",
    description: "Send a message or connect through the contact form.",
    href: "/#contact",
    icon: "location" as const,
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  schema={notFoundSchema}
  mainClass="max-w-[800px] m-auto py-16 px-4"
>
  <div class="text-center py-8 sm:py-12">
    <!-- 404 Glow Badge -->
    <div class="inline-flex items-center justify-center mb-6">
      <span
        class="text-6xl sm:text-8xl font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-sky-400 dark:from-cyan-400 dark:to-sky-300 drop-shadow-sm select-none"
      >
        404
      </span>
    </div>

    <!-- Error Heading & Description -->
    <h1
      class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4"
    >
      Page Not Found
    </h1>

    <p
      class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-md mx-auto mb-8 leading-relaxed"
    >
      Sorry, we couldn't find the page you're looking for. It might have been moved, renamed, or no longer exists.
    </p>

    <!-- Return Home Action -->
    <div class="flex justify-center mb-14">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-cyan-700 hover:bg-cyan-800 dark:bg-cyan-600 dark:hover:bg-cyan-500 text-white font-medium shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 cursor-pointer"
      >
        <Icon name="home" class="w-5 h-5" />
        <span>Return to Homepage</span>
      </a>
    </div>

    <!-- Helpful Quick Links Section -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-10 text-left">
      <h2
        class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-6 text-center sm:text-left"
      >
        Popular Destinations
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          quickLinks.map((link) => (
            <a
              href={link.href}
              class="group flex items-start gap-4 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 hover:bg-white dark:hover:bg-slate-900 hover:border-cyan-500/50 dark:hover:border-cyan-500/50 shadow-xs hover:shadow-md transition-all duration-200"
            >
              <div class="p-2.5 rounded-lg bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-400 group-hover:scale-105 transition-transform duration-200 shrink-0">
                <Icon name={link.icon} class="w-5 h-5" />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-1 mb-1">
                  <span class="font-semibold text-slate-900 dark:text-white group-hover:text-cyan-700 dark:group-hover:text-cyan-400 transition-colors">
                    {link.title}
                  </span>
                  <Icon
                    name="arrow-right"
                    class="w-4 h-4 text-slate-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shrink-0"
                  />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                  {link.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
