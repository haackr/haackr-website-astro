---
import Icon from "./Icon.astro";

const SOCIAL_LINKS = [
  {
    title: "Github",
    link: "https://github.com/haackr",
    icon: "github" as const,
  },
  {
    title: "Linkedin",
    link: "https://www.linkedin.com/in/haackr/",
    icon: "linkedin" as const,
  },
  {
    title: "Strava",
    link: "https://www.strava.com/athletes/ryan_haack",
    icon: "strava" as const,
  },
  {
    title: "Instagram",
    link: "https://www.instagram.com/haackr_505/",
    icon: "instagram" as const,
  },
  {
    title: "Youtube",
    link: "https://www.youtube.com/@haackr",
    icon: "youtube" as const,
  },
];

const { c } = Astro.props;
---

<footer
  class={"text-cyan-900 " + c}
  style="font-family: 'Poppins', sans-serif;"
>
  <div class="py-8">
    <div class="mb-4">
      <ul class="flex text-center justify-center gap-3">
        {
          SOCIAL_LINKS.map(({ title, link, icon }) => (
            <li>
              <a href={link} title={title} class="">
                <Icon
                  name={icon}
                  class="h-6 w-6 text-cyan-900 hover:text-cyan-800"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="text-cyan-900">
      Made with ❤ by me using <a href="https://astro.build/"
        ><Icon
          class="h-6 w-6 inline hover:text-cyan-800"
          name="astro"
        /></a
      >
    </p>
  </div>
</footer>
<style>
  footer {
    background: linear-gradient(var(--gray-gradient)) no-repeat;
    color: rgb(var(--gray));
    text-align: center;
  }
</style>
