---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

interface PhotoItem {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  location?: string;
  camera?: string;
}

interface Props {
  photos: PhotoItem[];
  title?: string;
  defaultLocation?: string;
}

const { photos = [], title = "Photo Gallery", defaultLocation = "" } = Astro.props;
---

<div
  id="photo-lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 opacity-0 transition-opacity duration-300 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label={`${title} Lightbox`}
  data-total-photos={photos.length}
>
  <!-- Close Button -->
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-4 right-4 z-50 p-3 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-400"
    aria-label="Close Lightbox"
  >
    <Icon name="close" class="w-6 h-6" />
  </button>

  <!-- Previous Button -->
  <button
    id="lightbox-prev"
    type="button"
    class="absolute left-4 top-1/2 -translate-y-1/2 z-50 p-3 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-400"
    aria-label="Previous Photo"
  >
    <Icon name="chevron-left" class="w-7 h-7" />
  </button>

  <!-- Next Button -->
  <button
    id="lightbox-next"
    type="button"
    class="absolute right-4 top-1/2 -translate-y-1/2 z-50 p-3 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-400"
    aria-label="Next Photo"
  >
    <Icon name="chevron-right" class="w-7 h-7" />
  </button>

  <!-- Main Content Container -->
  <div class="relative w-full h-full flex flex-col items-center justify-between p-4 sm:p-8 max-w-7xl mx-auto pointer-events-none">
    <!-- Top Bar / Counter -->
    <div class="w-full flex justify-between items-center text-sm text-slate-400 pt-2 px-2 pointer-events-auto">
      <span id="lightbox-counter" class="font-mono text-xs tracking-wider">
        1 / {photos.length}
      </span>
    </div>

    <!-- Center Slides Container -->
    <div
      id="lightbox-slides-container"
      class="relative flex-1 flex items-center justify-center w-full max-h-[78vh] my-auto overflow-hidden pointer-events-auto"
    >
      {
        photos.map((photo, index) => {
          const photoLocation = photo.location || defaultLocation;
          return (
            <div
              class="lightbox-slide absolute inset-0 flex items-center justify-center transition-opacity duration-250 ease-out opacity-0 pointer-events-none select-none"
              data-slide-index={index}
              data-caption={photo.caption || photo.alt || ""}
              data-location={photoLocation}
              data-camera={photo.camera || ""}
            >
              <Image
                src={photo.src}
                alt={photo.alt || photo.caption || `${title} photograph ${index + 1}`}
                width={1920}
                quality={85}
                format="webp"
                widths={[640, 1080, 1600, 1920]}
                sizes="(max-width: 768px) 95vw, 85vw"
                loading="lazy"
                decoding="async"
                class="max-h-[75vh] max-w-[92vw] sm:max-w-[85vw] w-auto h-auto object-contain rounded-lg shadow-2xl"
              />
            </div>
          );
        })
      }
    </div>

    <!-- Bottom Caption & Metadata Bar -->
    <div class="w-full bg-slate-900/80 border border-white/10 rounded-xl p-4 text-center sm:text-left sm:flex sm:items-center sm:justify-between gap-4 backdrop-blur-sm pointer-events-auto">
      <div>
        <p id="lightbox-caption" class="text-white font-medium text-base sm:text-lg mb-1"></p>
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs text-slate-300">
          <span id="lightbox-location" class="inline-flex items-center gap-1">
            <Icon name="location" class="w-3.5 h-3.5 text-cyan-400" />
            <span class="location-text"></span>
          </span>
          <span id="lightbox-camera" class="inline-flex items-center gap-1 text-slate-400">
            <Icon name="camera" class="w-3.5 h-3.5 text-slate-400" />
            <span class="camera-text"></span>
          </span>
        </div>
      </div>

      <div class="text-xs text-slate-500 hidden md:block">
        <span>Use <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-slate-300">←</kbd> <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-slate-300">→</kbd> to navigate · <kbd class="px-1.5 py-0.5 bg-white/10 rounded text-slate-300">ESC</kbd> to close</span>
      </div>
    </div>
  </div>
</div>

<script>
  let currentIndex = 0;
  let isOpen = false;

  function getLightbox(): HTMLElement | null {
    return document.getElementById("photo-lightbox");
  }

  function getSlides(lightbox: HTMLElement): HTMLDivElement[] {
    return Array.from(lightbox.querySelectorAll<HTMLDivElement>(".lightbox-slide"));
  }

  // Preload and decode a single slide just-in-time
  function preloadSlide(index: number) {
    const lightbox = getLightbox();
    if (!lightbox) return;
    const slides = getSlides(lightbox);
    if (index < 0 || index >= slides.length) return;
    const slide = slides[index];
    const img = slide?.querySelector<HTMLImageElement>("img");
    if (img) {
      if (img.loading === "lazy") {
        img.loading = "eager";
      }
      img.decode?.().catch(() => {});
    }
  }

  function showSlide(index: number) {
    const lightbox = getLightbox();
    if (!lightbox) return;
    const slides = getSlides(lightbox);
    if (slides.length === 0) return;

    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;
    currentIndex = index;

    const captionEl = document.getElementById("lightbox-caption");
    const counterEl = document.getElementById("lightbox-counter");
    const locationEl = document.getElementById("lightbox-location");
    const locationText = locationEl?.querySelector(".location-text");
    const cameraEl = document.getElementById("lightbox-camera");
    const cameraText = cameraEl?.querySelector(".camera-text");

    slides.forEach((slide, idx) => {
      if (idx === currentIndex) {
        slide.classList.remove("opacity-0", "pointer-events-none");
        slide.classList.add("opacity-100", "pointer-events-auto");

        // Preload active slide and immediate next/previous slides
        preloadSlide(currentIndex);
        preloadSlide((currentIndex + 1) % slides.length);
        preloadSlide((currentIndex - 1 + slides.length) % slides.length);

        // Update caption & metadata
        const caption = slide.dataset.caption || "";
        const location = slide.dataset.location || "";
        const camera = slide.dataset.camera || "";

        if (captionEl) captionEl.textContent = caption;

        if (locationEl && locationText) {
          if (location) {
            locationText.textContent = location;
            locationEl.classList.remove("hidden");
          } else {
            locationEl.classList.add("hidden");
          }
        }

        if (cameraEl && cameraText) {
          if (camera) {
            cameraText.textContent = camera;
            cameraEl.classList.remove("hidden");
          } else {
            cameraEl.classList.add("hidden");
          }
        }

        if (counterEl) {
          counterEl.textContent = `${currentIndex + 1} / ${slides.length}`;
        }
      } else {
        slide.classList.remove("opacity-100", "pointer-events-auto");
        slide.classList.add("opacity-0", "pointer-events-none");
      }
    });
  }

  function openLightbox(index: number) {
    const lightbox = getLightbox();
    if (!lightbox) return;
    isOpen = true;
    showSlide(index);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    void lightbox.offsetWidth; // Force DOM reflow for CSS opacity transition
    lightbox.classList.remove("opacity-0");
    lightbox.classList.add("opacity-100");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    const lightbox = getLightbox();
    if (!lightbox) return;
    isOpen = false;
    lightbox.classList.remove("opacity-100");
    lightbox.classList.add("opacity-0");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    setTimeout(() => {
      if (!isOpen && lightbox) {
        lightbox.classList.remove("flex");
        lightbox.classList.add("hidden");
      }
    }, 300);
  }

  function onPageLoad() {
    isOpen = false;
    document.body.style.overflow = "";
    const lightbox = getLightbox();
    if (lightbox) {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex", "opacity-100");
      lightbox.classList.add("opacity-0");
    }
  }

  // Attach global document listeners once across all client navigation
  if (!(window as any).__photoLightboxGlobalDelegatorAttached) {
    (window as any).__photoLightboxGlobalDelegatorAttached = true;

    // Preload full-res photo as soon as user hovers over/focuses thumbnail (intent to click)
    document.addEventListener(
      "pointerover",
      (e) => {
        const target = e.target as HTMLElement | null;
        const photoItem = target?.closest<HTMLElement>("[data-photo-item]");
        if (!photoItem) return;
        const customIdx = photoItem.dataset.photoIndex;
        if (customIdx !== undefined) {
          preloadSlide(parseInt(customIdx, 10));
        }
      },
      { passive: true }
    );

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Click on thumbnail
      const photoItem = target.closest<HTMLElement>("[data-photo-item]");
      if (photoItem) {
        e.preventDefault();
        e.stopPropagation();
        const customIdx = photoItem.dataset.photoIndex;
        let targetIndex = 0;
        if (customIdx !== undefined) {
          targetIndex = parseInt(customIdx, 10);
        } else {
          const allItems = Array.from(document.querySelectorAll<HTMLElement>("[data-photo-item]"));
          targetIndex = allItems.indexOf(photoItem);
        }
        openLightbox(targetIndex);
        return;
      }

      const lightbox = getLightbox();
      if (!lightbox || lightbox.classList.contains("hidden")) return;

      // Click close button
      if (target.closest("#lightbox-close")) {
        e.preventDefault();
        closeLightbox();
        return;
      }

      // Click prev button
      if (target.closest("#lightbox-prev")) {
        e.preventDefault();
        showSlide(currentIndex - 1);
        return;
      }

      // Click next button
      if (target.closest("#lightbox-next")) {
        e.preventDefault();
        showSlide(currentIndex + 1);
        return;
      }

      // Click backdrop (outside content)
      if (target === lightbox || target.id === "lightbox-slides-container") {
        e.preventDefault();
        closeLightbox();
        return;
      }
    });

    window.addEventListener("keydown", (e: KeyboardEvent) => {
      if (!isOpen) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") showSlide(currentIndex - 1);
      if (e.key === "ArrowRight") showSlide(currentIndex + 1);
    });

    let touchStartX = 0;
    let touchEndX = 0;

    document.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        if (!isOpen) return;
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    document.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        if (!isOpen) return;
        touchEndX = e.changedTouches[0].screenX;
        const swipeDistance = touchEndX - touchStartX;
        if (Math.abs(swipeDistance) > 50) {
          if (swipeDistance > 0) {
            showSlide(currentIndex - 1);
          } else {
            showSlide(currentIndex + 1);
          }
        }
      },
      { passive: true }
    );
  }

  // Run on initial load and on Astro View Transitions
  onPageLoad();
  document.addEventListener("astro:page-load", onPageLoad);
</script>
