---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Icon from "../components/Icon.astro";

type Props = CollectionEntry<"projects">["data"];

const {
  title,
  description,
  pubDate,
  heroImage,
  heroImageAlt,
  tags = [],
  liveUrl,
  repoUrl,
} = Astro.props;

const heroImageSrc =
  typeof heroImage === "object" && heroImage !== null
    ? heroImage.src
    : heroImage;

const projectSchema = {
  "@context": "https://schema.org",
  "@type": repoUrl ? "SoftwareSourceCode" : "CreativeWork",
  name: title,
  description: description,
  datePublished: pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: "Ryan Haack",
    url: "https://haackr.com",
  },
  ...(repoUrl ? { codeRepository: repoUrl } : {}),
  ...(liveUrl ? { url: liveUrl } : {}),
  ...(heroImageSrc
    ? { image: new URL(heroImageSrc, Astro.site).href }
    : {}),
  ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": Astro.url.href,
  },
};
---

<BaseLayout
  title={`${title} | Ryan Haack`}
  description={description}
  image={heroImage}
  imageAlt={heroImageAlt || title}
  type="article"
  publishedTime={pubDate}
  schema={projectSchema}
  mainClass="max-w-[900px] m-auto py-8 px-4"
>
  <nav class="mb-8">
    <a
      href="/projects/"
      class="inline-flex items-center gap-2 text-cyan-700 hover:text-cyan-900 font-medium transition-colors"
    >
      <Icon name="arrow-left" class="w-4 h-4" />
      <span>Back to Projects</span>
    </a>
  </nav>

  <header class="mb-8">
    <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" class="w-4 h-4 text-cyan-700" />
        <FormattedDate date={pubDate} />
      </span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4 tracking-tight">
      {title}
    </h1>

    <p class="text-base sm:text-lg text-slate-700 leading-relaxed mb-6">
      {description}
    </p>

    <!-- Tech Stack Tags -->
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {tags.map((tag) => (
            <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium rounded-full bg-cyan-50 text-cyan-800 border border-cyan-200">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Action Links -->
    {
      (liveUrl || repoUrl) && (
        <div class="flex flex-wrap gap-3 pt-2">
          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-cyan-700 hover:bg-cyan-800 rounded-lg shadow-sm transition-all"
            >
              <span>Visit Live Project</span>
              <Icon name="external" class="w-4 h-4" />
            </a>
          )}
          {repoUrl && (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-300 transition-all"
            >
              <Icon name="github" class="w-4 h-4" />
              <span>View Source</span>
            </a>
          )}
        </div>
      )
    }
  </header>

  <!-- Hero Image -->
  {
    heroImage && (
      <div class="mb-10 overflow-hidden rounded-xl shadow-md border border-slate-200">
        <Image
          src={heroImage}
          alt={heroImageAlt || title}
          width={1200}
          height={675}
          quality={85}
          format="webp"
          widths={[400, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 900px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto object-cover"
        />
      </div>
    )
  }

  <hr class="border-slate-200 mb-8" />

  <!-- Case Study Body -->
  <article
    class="prose prose-slate max-w-none md:prose-lg
    prose-headings:font-heading
    prose-p:font-sans
    prose-a:text-cyan-700 hover:prose-a:text-cyan-900
    prose-img:rounded-xl prose-img:shadow-md prose-img:mx-auto"
  >
    <slot />
  </article>
</BaseLayout>

